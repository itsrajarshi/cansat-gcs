  {
  "name": "cansat-gcs-project",
  "version": "1.0.0",
  "description": "CanSat Ground Control Software - Real-time telemetry monitoring system",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "tsc --strict",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "clean": "rm -rf dist node_modules package-lock.json"
  },
  "keywords": [
    "cansat",
    "ground-control",
    "telemetry",
    "aerospace",
    "gcs",
    "real-time",
    "monitoring",
    "mission-control"
  ],
  "author": "ISL Internship Program",
  "license": "ISL-Academic",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "recharts": "^2.10.3",
    "leaflet": "^1.9.4",
    "three": "^r155",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "lucide-react": "^0.263.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.8.10",
    "@types/three": "^r155",
    "@types/leaflet": "^1.9.8",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.2",
    "typescript": "^5.2.2",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "@tailwindcss/forms": "^0.5.6",
    "prettier": "^3.0.0"
  }
}
